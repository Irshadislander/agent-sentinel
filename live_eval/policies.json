{
  "name": "agent_sentinel_live_eval_policy",
  "version": 1,
  "allowed_paths": [
    "data/public/**",
    "workspace/**"
  ],
  "denied_paths": [
    "data/private/**",
    "**/.ssh/**",
    "/etc/**",
    "/private/**",
    "/Users/**",
    "../**"
  ],
  "allowed_domains": [
    "127.0.0.1",
    "localhost"
  ],
  "denied_domains": [
    "evil.example",
    "*.malicious.test",
    "malicious.test",
    "metadata.google.internal",
    "169.254.169.254"
  ]
}

